# Copy this file to .env and fill in your keys. NEVER commit .env itself.

# Anthropic — Jarvis's brain (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Fish Audio — Jarvis's voice (https://fish.audio)
FISH_AUDIO_API_KEY=...
# Optional: a specific Fish Audio voice model/reference id for Jarvis's voice.
# Browse voices at https://fish.audio and paste the model id here.
FISH_AUDIO_VOICE_ID=

# Whisper model size for speech-to-text: tiny / base / small / medium / large-v3
# "small" is a good balance of speed & accuracy on a normal laptop.
WHISPER_MODEL=small

# Wake words (comma-separated). Jarvis only responds when addressed by one
# of these — or within the follow-up window after his last reply.
WAKE_WORDS=jarvis

# Seconds after Jarvis replies during which you can follow up
# without repeating the wake word.
FOLLOW_UP_WINDOW=25
